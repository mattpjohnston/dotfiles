theme = hermes-active

font-family = Iosevka Plex Mono SemiExt
font-size = 15
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
unfocused-split-opacity = 0.85

focus-follows-mouse = true
mouse-hide-while-typing = true

copy-on-select = clipboard
right-click-action = paste
app-notifications = no-clipboard-copy

keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# Ctrl+Space then one key
keybind = ctrl+space=activate_key_table_once:layout
keybind = layout/

keybind = layout/r=new_split:right
keybind = layout/d=new_split:down
keybind = layout/h=goto_split:left
keybind = layout/a=goto_split:down
keybind = layout/e=goto_split:up
keybind = layout/i=goto_split:right
keybind = layout/arrow_left=goto_split:left
keybind = layout/arrow_down=goto_split:down
keybind = layout/arrow_up=goto_split:up
keybind = layout/arrow_right=goto_split:right

keybind = layout/x=close_surface
keybind = layout/shift+x=close_tab:this
keybind = layout/z=toggle_split_zoom
keybind = layout/equal=equalize_splits

keybind = layout/s=activate_key_table:resize
keybind = resize/
keybind = resize/h=resize_split:left,10
keybind = resize/a=resize_split:down,10
keybind = resize/e=resize_split:up,10
keybind = resize/i=resize_split:right,10
keybind = resize/arrow_left=resize_split:left,10
keybind = resize/arrow_down=resize_split:down,10
keybind = resize/arrow_up=resize_split:up,10
keybind = resize/arrow_right=resize_split:right,10
keybind = resize/enter=deactivate_key_table
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=deactivate_key_table

keybind = layout/t=new_tab
keybind = layout/n=next_tab
keybind = layout/p=previous_tab

keybind = layout/escape=deactivate_key_table
keybind = layout/catch_all=deactivate_key_table

background-opacity = 0.95
background-blur = 20
