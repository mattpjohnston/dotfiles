{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "pulseaudio",
    "custom/cpu",
    "temperature",
    "custom/memory",
    "idle_inhibitor"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "network": {
    "format-wifi": "<span font_family='Font Awesome 6 Free' weight='900'></span> ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "format-ethernet": "<span font_family='Font Awesome 6 Free' weight='900'></span> ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "format-disconnected": "<span font_family='Font Awesome 6 Free' weight='900'></span>",
    "tooltip-format-wifi": "{essid} {signalStrength}% ({frequency} GHz)\n{ifname}: {ipaddr}\nDown {bandwidthDownBits}/s, up {bandwidthUpBits}/s",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}\nDown {bandwidthDownBits}/s, up {bandwidthUpBits}/s",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": " {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth: {status}"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "tooltip-format": "Volume {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "custom/cpu": {
    "exec": "waybar-cpu",
    "format": "<span font_family='Font Awesome 6 Free' weight='900'></span> {}",
    "return-type": "json",
    "tooltip": true,
    "interval": 2
  },

  "custom/memory": {
    "exec": "waybar-memory",
    "format": "<span font_family='Font Awesome 6 Free' weight='900'></span> {}",
    "return-type": "json",
    "tooltip": true,
    "interval": 5
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "<span font_family='Font Awesome 6 Free' weight='900'></span> {temperatureC}°C",
    "tooltip-format": "CPU Tctl {temperatureC}°C"
  },

  "clock": {
    "format": "{:%A %H:%M}",
    "format-alt": "{:%d %B W%V %Y}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  }
}
